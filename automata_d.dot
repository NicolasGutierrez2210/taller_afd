digraph AFD_d {
    rankdir=LR;
    node [fontname="Helvetica"];
    
    start [shape=point, label=""];
    q0 [shape=circle, label="q0"];
    q1 [shape=circle, label="q1"];
    q2 [shape=circle, label="q2"];
    q3 [shape=doublecircle, label="q3"];
    
    start -> q0;
    q0 -> q1 [label="a"];
    q0 -> q0 [label="b"];
    q1 -> q1 [label="a"];
    q1 -> q2 [label="b"];
    q2 -> q1 [label="a"];
    q2 -> q3 [label="b"];
    q3 -> q1 [label="a"];
    q3 -> q0 [label="b"];
}
